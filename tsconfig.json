{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "types": ["react", "react-native"],
    "paths": {
      "@/*":            ["./*"],
      "@components/*":  ["components/*"],
      "@services/*":    ["services/*"],
      "@presentation/*": ["presentation/*"],
      "@providers/*":   ["providers/*"],
      "@context/*":     ["context/*"],
      "@hooks/*":       ["hooks/*"],
      "@type/*":        ["type/*"],
      "@constants/*":   ["constants/*"],
      "@assets/*":      ["assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
